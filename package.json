{
  "name": "counter-app",
  "version": "0.1.0",
  "private": true,
  "homepage": "/reactappnpmdemo",
  "dependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "ajv": "^8.17.1",
    "bootstrap": "5.3.8",
    "@mstechusa/eviewer7": "^7.2.42",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-pdf": "10.2.0",
    "react-scripts": "5.0.1",
    "typescript": "5.9.3",
    "uuid": "13.0.0",
    "web-vitals": "5.1.0"
  },
  "scripts": {
    "start": "react-scripts --max_old_space_size=10000 start",
    "build": "react-scripts --max_old_space_size=10000 build",
    "test": "react-scripts test --transformIgnorePatterns \"node_modules/(?!eviewerjs)/\"",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "eqeqeq": "off",
      "no-unused-vars": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint-plugin-react": "7.37.5"
  }
}
